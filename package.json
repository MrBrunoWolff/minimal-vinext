{
  "name": "minimal-vinext",
  "version": "1.0.0",
  "description": "Minimal vinext starter kit with App Router and Cloudflare Workers",
  "keywords": [
    "cloudflare",
    "cloudflare-workers",
    "minimal",
    "next",
    "nextjs",
    "react",
    "starter",
    "template",
    "typescript",
    "vinext",
    "vite"
  ],
  "license": "MIT",
  "author": "Bruno Wolff",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrBrunoWolff/minimal-vinext.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "deploy": "vinext deploy",
    "typecheck": "vinext typegen && tsc --noEmit",
    "doctor": "bunx react-doctor -y --no-ami .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "check": "oxlint && oxfmt --check .",
    "clean": "rm -rf node_modules/.vite .wrangler dist"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-server-dom-webpack": "^19.2.7",
    "vinext": "0.1.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.42.1",
    "@cloudflare/workers-types": "4.20260623.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-rsc": "0.5.27",
    "next": "^16.2.9",
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0",
    "react-doctor": "0.5.8",
    "typescript": "^6.0.3",
    "vite": "8.1.0",
    "wrangler": "4.103.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
