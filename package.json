{
  "name": "minimal-vinext",
  "version": "1.0.0",
  "description": "Minimal vinext starter kit with App Router and Cloudflare Workers",
  "keywords": [
    "cloudflare",
    "cloudflare-workers",
    "minimal",
    "next",
    "nextjs",
    "react",
    "starter",
    "template",
    "typescript",
    "vinext",
    "vite"
  ],
  "license": "MIT",
  "author": "Bruno Wolff",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrBrunoWolff/minimal-vinext.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview --port ${PORT:-3000}",
    "deploy": "bun run build && cf deploy --prebuilt",
    "typecheck": "vinext typegen && bun run typecheck:only",
    "doctor": "bunx react-doctor -y --no-ami .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write . '!.agents/**' '!.claude/**'",
    "fmt:check": "oxfmt --check . '!.agents/**' '!.claude/**'",
    "check": "bun run typegen && bun run --parallel --no-exit-on-error lint fmt:check typecheck:only knip",
    "clean": "rm -rf node_modules/.vite .wrangler dist",
    "knip": "knip",
    "typegen": "vinext typegen",
    "typecheck:only": "tsc --noEmit",
    "audit": "bun audit --audit-level=high --ignore=GHSA-vfj7-8cjw-p6xm"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "latest",
    "vinext": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@cloudflare/workers-types": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vinext/cloudflare": "latest",
    "@vitejs/plugin-rsc": "latest",
    "cf": "latest",
    "knip": "latest",
    "next": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "react-doctor": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "latest"
  },
  "overrides": {
    "miniflare>sharp": "0.35.5",
    "miniflare>undici": "7.29.1"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.4.0"
}
