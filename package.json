{
  "name": "minimal-vinext",
  "version": "1.0.0",
  "description": "Minimal vinext starter kit with App Router and Cloudflare Workers",
  "keywords": [
    "cloudflare",
    "cloudflare-workers",
    "minimal",
    "next",
    "nextjs",
    "react",
    "starter",
    "template",
    "typescript",
    "vinext",
    "vite"
  ],
  "license": "MIT",
  "author": "Bruno Wolff",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrBrunoWolff/minimal-vinext.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "deploy": "vinext deploy",
    "typecheck": "vinext typegen && tsc --noEmit",
    "doctor": "bunx react-doctor -y --no-ami .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "check": "oxlint && oxfmt --check .",
    "clean": "rm -rf node_modules/.vite .wrangler dist"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-server-dom-webpack": "^19.2.7",
    "vinext": "1.0.0-beta.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.44.0",
    "@cloudflare/workers-types": "5.20260711.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-rsc": "0.5.27",
    "next": "^16.2.10",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "react-doctor": "0.7.4",
    "typescript": "^7.0.2",
    "vite": "8.1.4",
    "wrangler": "4.110.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
